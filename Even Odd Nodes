import java.util.*;

class Solution {
    static LinkedListNode sortList(LinkedListNode head){
        // Write your code here
        
        LinkedListNode evenHead=null;
        LinkedListNode oddHead=null;
        LinkedListNode evenTail = null;
        LinkedListNode oddTail=null;
        LinkedListNode temp=head;
        while(temp!=null){
            if(temp.data%2==0){
                if(evenHead==null){
                    evenHead=temp;
                    evenTail=temp;
                }
                else{
                    evenTail.next=temp;
                    evenTail=temp;
                }
            }
            else{
                if(oddHead==null){
                    oddHead=temp;
                    oddTail=temp;
                }else{
                    oddTail.next=temp;
                    oddTail=temp;
                }
            }
            temp=temp.next;
        }
        evenTail.next=oddHead;
        return evenHead;
        
    }
}

class LinkedListNode  {
    int data;
    LinkedListNode next;

    public LinkedListNode(int data)  {
        this.data = data;
    }
}

public class Main {
    public static void main(String[] args) throws Throwable {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        LinkedListNode head = new LinkedListNode(sc.nextInt());
        LinkedListNode a = head;
        for(int i=1;i<n;i++) {
            LinkedListNode temp = new LinkedListNode(sc.nextInt());
            a.next = temp;
            a = temp;
        }
        LinkedListNode ans = Solution.sortList(head);
        for(int i=0;i<n;i++) {
            if(i == n-1) {
                System.out.println(ans.data);
            }
            else {
                System.out.print(ans.data + " ");
            }
            ans = ans.next;
        }
    }
}
