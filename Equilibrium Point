class Solution {
 
    public static int equilibriumPoint(int arr[]) {
        // code here
        int n=arr.length;
        int totalsum=0;
        int rightsum=0;
        int leftsum=0;
        for(int i=0;i<n;i++)
        {
            totalsum+=arr[i];
        }
        for(int i=0;i<n;i++)
        {
            rightsum=totalsum-leftsum-arr[i];
            if(leftsum==rightsum)
            {
                return i+1;
            }
            leftsum+=arr[i];
        }
        return -1;
    }
}
